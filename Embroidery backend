from flask import Flask, request, send_file, jsonify
import os
import cv2
import numpy as np
from PIL import Image
import subprocess
from werkzeug.utils import secure_filename

# Initialize Flask App
app = Flask(__name__)
UPLOAD_FOLDER = "uploads"
OUTPUT_FOLDER = "output"
ALLOWED_EXTENSIONS = {"png", "jpg", "jpeg"}
app.config["UPLOAD_FOLDER"] = UPLOAD_FOLDER
app.config["OUTPUT_FOLDER"] = OUTPUT_FOLDER

# Ensure directories exist
os.makedirs(UPLOAD_FOLDER, exist_ok=True)
os.makedirs(OUTPUT_FOLDER, exist_ok=True)

# Allowed file type check
def allowed_file(filename):
    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS

# Process image: resize & color quantization
def process_image(image_path, output_path, resize=None, colors=1):
    img = cv2.imread(image_path)

    # Resize if needed
    if resize:
        img = cv2.resize(img, (resize[0], resize[1]))

    # Color quantization
    if colors > 1:
        Z = img.reshape((-1, 3))
        Z = np.float32(Z)
        criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 10, 1.0)
        _, labels, centers = cv2.kmeans(Z, colors, None, criteria, 10, cv2.KMEANS_RANDOM_CENTERS)
        centers = np.uint8(centers)
        quantized = centers[labels.flatten()]
        img = quantized.reshape((img.shape))

    cv2.imwrite(output_path, img)
    return output_path

# Convert to SVG (Vector Format)
def convert_to_svg(input_path, svg_output_path):
    command = f"potrace {input_path} -s -o {svg_output_path}"
    subprocess.run(command, shell=True, check=True)
    return svg_output_path

# Convert SVG to embroidery format
def convert_to_embroidery(svg_path, output_path, format):
    command = f"inkscape --export-filename={output_path} --export-type={format.upper()} {svg_path}"
    subprocess.run(command, shell=True, check=True)
    return output_path

# API Route: Upload Image & Convert
@app.route("/convert", methods=["POST"])
def convert():
    if "file" not in request.files:
        return jsonify({"error": "No file uploaded"}), 400

    file = request.files["file"]
    if file.filename == "" or not allowed_file(file.filename):
        return jsonify({"error": "Invalid file format"}), 400

    filename = secure_filename(file.filename)
    image_path = os.path.join(UPLOAD_FOLDER, filename)
    file.save(image_path)

    # Get parameters
    format = request.form.get("format", "dst")
    resize = (int(request.form.get("width", 500)), int(request.form.get("height", 500))) if "resize" in request.form else None
    colors = int(request.form.get("colors", 1))

    # Process Image
    processed_path = os.path.join(UPLOAD_FOLDER, f"processed_{filename}")
    process_image(image_path, processed_path, resize, colors)

    # Convert to SVG
    svg_path = os.path.join(OUTPUT_FOLDER, f"{filename}.svg")
    convert_to_svg(processed_path, svg_path)

    # Convert to Embroidery Format
    output_path = os.path.join(OUTPUT_FOLDER, f"{filename}.{format}")
    convert_to_embroidery(svg_path, output_path, format)

    return send_file(output_path, as_attachment=True)

# Run Flask App
if __name__ == "__main__":
    app.run(debug=True, host="0.0.0.0", port=5000)
